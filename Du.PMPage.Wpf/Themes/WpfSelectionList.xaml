<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Du.PMPage.Wpf">

    <!--
        ═══════════════════════════════════════════════════════════════
        WpfSelectionList default style.
        Mimics a SolidWorks selection-box list with active/inactive
        visual states and an empty-state placeholder.
        ═══════════════════════════════════════════════════════════════
    -->
    <Style TargetType="{x:Type local:WpfSelectionList}">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="MinHeight" Value="14" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#FFABADB3" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="2,1" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border
                                    x:Name="Bd"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True">
                                    <ContentPresenter
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        SnapsToDevicePixels="True" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#FFECF4FD" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#FFB4D6F5" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#FFD0E4F7" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#FF53A9FF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:WpfSelectionList}">
                    <Border
                        x:Name="RootBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">

                        <Grid>
                            <!--  Empty-state placeholder  -->
                            <TextBlock
                                x:Name="PART_EmptyText"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{TemplateBinding Foreground}"
                                Opacity="0.45"
                                Text="Click to activate, then select geometry in the graphics area."
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Visibility="Visible" />

                            <!--  Items host  -->
                            <ScrollViewer
                                x:Name="PART_ScrollViewer"
                                CanContentScroll="True"
                                HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                <ItemsPresenter x:Name="ItemsHost" />
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!--  Show/hide empty-state placeholder  -->
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="PART_EmptyText" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!--  Active (clicked) state — blue highlight  -->
                        <Trigger Property="IsActive" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="#FFCFE4F7" />
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="#FF53A9FF" />
                            <Setter TargetName="RootBorder" Property="BorderThickness" Value="2" />
                        </Trigger>

                        <!--  Mouse-over on background  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsActive" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="#FF7EB4E0" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <!--  Legacy triggers kept for non-templated fallback  -->
        <Style.Triggers>
            <Trigger Property="IsActive" Value="True">
                <Setter Property="Background" Value="#FFCFE4F7" />
                <Setter Property="BorderBrush" Value="#FF53A9FF" />
                <Setter Property="BorderThickness" Value="2" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        ═══════════════════════════════════════════════════════════════
        SldListBoxStyle — shared style key for plain ListBox elements
        that need the active-selection look.
        ═══════════════════════════════════════════════════════════════
    -->
    <Style x:Key="SldListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="#FFCFE4F7" />
        <Setter Property="BorderBrush" Value="#FF53A9FF" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="MinHeight" Value="14" />
    </Style>

</ResourceDictionary>
