<pmp:SldTaskPane
    x:Class="PMPageAddin.TaskPanePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PMPageAddin"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pmp="https://github.com/weianweigan/PMPageControl/wpf"
    d:DataContext="{d:DesignInstance Type=local:TaskPaneViewModel}"
    d:DesignHeight="400"
    d:DesignWidth="280"
    Background="#F7F7F7"
    TaskPaneToolTip="PMPageControl TaskPane Demo"
    mc:Ignorable="d">

    <!--
        TaskPane Demo
        Demonstrates hosting custom WPF content in a SolidWorks TaskPane.
        Unlike PMPage, TaskPane content uses standard WPF controls — the
        full .NET/WPF ecosystem is available (charts, data grids, media,
        custom drawings, etc.).
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Border
            Grid.Row="0"
            Padding="12,10"
            Background="{DynamicResource SldBackground}">
            <TextBlock
                FontSize="14"
                FontWeight="SemiBold"
                Text="TaskPane Demo"
                TextWrapping="Wrap" />
        </Border>

        <!--  Welcome message  -->
        <TextBlock
            Grid.Row="1"
            Margin="12,10,12,0"
            FontSize="12"
            Text="This panel is hosted in a native SolidWorks TaskPane via SldTaskPane. Standard WPF controls work here."
            TextWrapping="Wrap" />

        <!--  Active document info  -->
        <Border
            Grid.Row="2"
            Margin="12,10,12,0"
            Padding="10"
            Background="White"
            BorderBrush="{DynamicResource SldBorder}"
            BorderThickness="1">
            <StackPanel>
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="Active Document" />
                <TextBlock
                    x:Name="DocumentTitleText"
                    Margin="0,6,0,0"
                    FontSize="11"
                    Foreground="#FF444444"
                    Text="{Binding DocumentTitle}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!--  Action buttons  -->
        <Border
            Grid.Row="3"
            Margin="12,10,12,0"
            Padding="10"
            Background="White"
            BorderBrush="{DynamicResource SldBorder}"
            BorderThickness="1">
            <StackPanel>
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="Actions" />
                <Button
                    x:Name="RefreshButton"
                    Height="28"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Stretch"
                    Command="{Binding RefreshCommand}"
                    Content="Refresh Document Info"
                    FontSize="11" />
                <Button
                    x:Name="CountButton"
                    Height="28"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Stretch"
                    Command="{Binding IncrementCommand}"
                    Content="{Binding CountButtonText}"
                    FontSize="11" />
            </StackPanel>
        </Border>

        <!--  Log output  -->
        <Border
            Grid.Row="4"
            Margin="12,10,12,12"
            Padding="10"
            Background="White"
            BorderBrush="{DynamicResource SldBorder}"
            BorderThickness="1">
            <StackPanel>
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="Activity Log" />
                <ScrollViewer
                    MaxHeight="120"
                    Margin="0,6,0,0"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding LogEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    FontSize="10"
                                    Foreground="#FF444444"
                                    Text="{Binding}"
                                    TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>

</pmp:SldTaskPane>
