<page:SldPMPage
    x:Class="PMPageAddin.SelectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PMPageAddin"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:page="clr-namespace:Du.PMPage.Wpf;assembly=Du.PMPage.Wpf"
    xmlns:swcontrols="clr-namespace:Du.PMPage.Wpf.Controls;assembly=Du.PMPage.Wpf"
    d:DataContext="{d:DesignInstance Type=local:SelectionPageViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="300"
    PageHeight="200"
    PageTitle="Demo Selection Page"
    mc:Ignorable="d">
    <swcontrols:SldGroupBox Caption="Number box">
        <swcontrols:SldNumberBox Value="{Binding Num1}" />
    </swcontrols:SldGroupBox>
    <swcontrols:SldGroupBox Caption="Number box">
        <swcontrols:SldNumberBox Value="{Binding Num2}" />
    </swcontrols:SldGroupBox>
    <swcontrols:SldGroupBox Caption="Wpf">
        <swcontrols:SldContentHost PageHeight="100">
            <Grid Height="100" Background="Green">
                <TextBlock Foreground="Red" Text="wpf textbox" />
            </Grid>
        </swcontrols:SldContentHost>
    </swcontrols:SldGroupBox>
</page:SldPMPage>
